{
  "name": "routebird",
  "version": "0.1.0",
  "private": true,
  "description": "Routebird — visa-aware flights for Australia's students & migrants",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
